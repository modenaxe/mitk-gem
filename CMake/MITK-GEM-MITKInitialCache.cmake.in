# MITK-GEM requires the standard MITK Segmentation workbench view. The VCLab
# whitelist makes this plug-in eligible, but MITK declares it OFF by default.
# This initial-cache file is used because the dotted cache key cannot be passed
# with CMake's -D command-line syntax.
set(MITK_BUILD_org.mitk.gui.qt.segmentation ON CACHE BOOL
  "Build the org.mitk.gui.qt.segmentation plug-in." FORCE)

# The VCLab whitelist makes this plug-in eligible, but it is OFF by default
# in MITK. It provides both the Measurement and Statistics views that were
# part of the legacy MITK-GEM distribution.
set(MITK_BUILD_org.mitk.gui.qt.measurementtoolbox ON CACHE BOOL
  "Build the org.mitk.gui.qt.measurementtoolbox plug-in." FORCE)

# The DICOM browser is an editor (opened from the DICOM toolbar button) and
# the inspector is a view. Both are disabled by MITK's default profile even
# when their modules are whitelisted.
set(MITK_BUILD_org.mitk.gui.qt.dicombrowser ON CACHE BOOL
  "Build the org.mitk.gui.qt.dicombrowser plug-in." FORCE)
set(MITK_BUILD_org.mitk.gui.qt.dicominspector ON CACHE BOOL
  "Build the org.mitk.gui.qt.dicominspector plug-in." FORCE)

# MITK builds and stages its patched Boost 1.85 headers in the superbuild
# prefix. Homebrew CGAL also installs a newer system Boost whose CMake package
# can otherwise take precedence on macOS. MITK 2025.12.2 still uses a Boost
# 1.85 lexical_cast detail API, so force FindBoost's module search to honour
# the staged Boost_ROOT instead of selecting a system BoostConfig.cmake.
set(Boost_NO_BOOST_CMAKE ON CACHE BOOL
  "Do not use a system BoostConfig.cmake while configuring MITK." FORCE)
set(Boost_NO_SYSTEM_PATHS ON CACHE BOOL
  "Restrict MITK Boost discovery to its superbuild prefix." FORCE)

# CMake treats include directories from imported targets as system includes by
# default. On the Intel macOS runner, Clang searches its implicit
# /usr/local/include directory before such -isystem paths, so Homebrew's newer
# Boost headers can shadow the Boost 1.85 headers found by MITK. Keep imported
# dependency includes at normal -I priority so the selected package is also
# the package used by the compiler.
set(CMAKE_NO_SYSTEM_FROM_IMPORTED ON CACHE BOOL
  "Keep staged MITK dependencies ahead of implicit system include paths." FORCE)
